<script>
const redMot=matchMedia('(prefers-reduced-motion: reduce)').matches;
// Openingssequentie: kop in losse letters (gevelschilder-effect)
const kop=document.querySelector('.gevel h1');
if(kop&&!redMot){
  const woorden=kop.textContent.trim().split(' ');kop.textContent='';let i=0;
  woorden.forEach((w,wi)=>{
    const ws=document.createElement('span');ws.style.display='inline-block';ws.style.whiteSpace='nowrap';
    [...w].forEach(l=>{const s=document.createElement('span');s.className='lt';s.textContent=l;s.style.transitionDelay=(0.35+i*0.038)+'s';ws.appendChild(s);i++});
    kop.appendChild(ws);
    if(wi<woorden.length-1){const sp=document.createElement('span');sp.className='sp';kop.appendChild(sp)}
  });
}
// gouden stof in de gevel
if(!redMot){
  const gv=document.querySelector('.gevel');
  for(let i=0;i<16;i++){
    const d=document.createElement('span');d.className='stof';
    const gr=3+Math.random()*6;
    d.style.width=d.style.height=gr+'px';
    d.style.left=(Math.random()*100)+'%';
    d.style.animationDuration=(14+Math.random()*16)+'s';
    d.style.animationDelay=(-Math.random()*22)+'s';
    gv.appendChild(d);
  }
}
addEventListener('load',()=>{document.body.classList.add('geladen');
  const u=document.getElementById('uithang');if(u)setTimeout(()=>u.classList.add('slinger'),2400);
});
if(redMot)document.body.classList.add('geladen');
// nav
const nav=document.getElementById('nav');
const navScroll=()=>nav.classList.toggle('scrolled',scrollY>50);
addEventListener('scroll',navScroll,{passive:true});navScroll();
const burger=document.getElementById('burger'),links=document.getElementById('navLinks');
burger.addEventListener('click',()=>{const o=links.classList.toggle('open');burger.classList.toggle('open',o);burger.setAttribute('aria-expanded',o)});
links.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{links.classList.remove('open');burger.classList.remove('open');burger.setAttribute('aria-expanded','false')}));
// merkenlint naadloos
const t=document.getElementById('lintTrack');t.innerHTML+=t.innerHTML;
// reveals
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('zien');io.unobserve(e.target)}}),{threshold:.12});
document.querySelectorAll('.rv').forEach(el=>io.observe(el));
// tellers
const tio=new IntersectionObserver(es=>es.forEach(e=>{
  if(!e.isIntersecting)return;
  const el=e.target,doel=parseInt(el.dataset.tel,10);tio.unobserve(el);
  if(redMot){el.textContent=el.dataset.tel;return}
  const t0=performance.now(),dur=1400;
  const stap=n=>{const p=Math.min((n-t0)/dur,1);el.textContent=Math.round(doel*(1-Math.pow(1-p,3)));if(p<1)requestAnimationFrame(stap)};
  requestAnimationFrame(stap);
}),{threshold:.6});
document.querySelectorAll('[data-tel]').forEach(el=>tio.observe(el));
// SIGNATUUR: sepia → kleur bij binnenstappen
const gevelBg=document.getElementById('gevelBg'),gevel=document.getElementById('gevel'),medail=document.querySelector('.gevel-medaillon img');
function stapBinnen(){
  if(redMot)return;
  const h=gevel.offsetHeight,p=Math.min(Math.max(scrollY/(h*.85),0),1);
  gevelBg.style.setProperty('--sep',(0.6*(1-p)).toFixed(3));
  gevelBg.style.setProperty('--zoom',(1+p*.06).toFixed(4));
  if(medail)medail.style.filter='grayscale('+(1-p).toFixed(3)+') sepia('+(0.42*(1-p)).toFixed(3)+') brightness(.96) contrast(1.04)';
}
addEventListener('scroll',stapBinnen,{passive:true});stapBinnen();
// voortgang + rollende pokébal
const balk=document.getElementById('balk'),rolbal=document.getElementById('rolbal');
function vg(){const h=document.documentElement,p=h.scrollTop/(h.scrollHeight-h.clientHeight||1);balk.style.width=(p*100)+'%';rolbal.style.left='calc('+(p*100)+'% - 11px)';rolbal.style.transform='rotate('+(p*1080)+'deg)'}
addEventListener('scroll',vg,{passive:true});vg();
// sterrenstof
function vonken(el){
  if(redMot)return;
  const r=el.getBoundingClientRect(),syms=['\u2726','\u2727','\u2605','\u272A'];
  for(let i=0;i<12;i++){
    const s=document.createElement('span');s.className='vonk';
    s.textContent=syms[Math.floor(Math.random()*syms.length)];
    const hoek=Math.random()*Math.PI*2,af=46+Math.random()*66;
    s.style.left=(r.left+r.width/2)+'px';s.style.top=(r.top+r.height/2)+'px';
    s.style.fontSize=(9+Math.random()*13)+'px';
    s.style.setProperty('--dx',Math.cos(hoek)*af+'px');
    s.style.setProperty('--dy',Math.sin(hoek)*af+'px');
    s.style.setProperty('--dr',(Math.random()*220-110)+'deg');
    document.body.appendChild(s);setTimeout(()=>s.remove(),800);
  }
}
document.querySelectorAll('.vonkbaar').forEach(el=>{
  let ok=true;
  el.addEventListener('mouseenter',()=>{if(ok){ok=false;vonken(el);setTimeout(()=>ok=true,450)}});
  el.addEventListener('click',()=>vonken(el));
});
// 3D-tilt op schappenkaarten
if(!redMot&&matchMedia('(pointer: fine)').matches){
  document.querySelectorAll('.acard').forEach(c=>{
    c.addEventListener('mousemove',e=>{
      const r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
      c.style.transform='translateY(-5px) rotateX('+(-y*6)+'deg) rotateY('+(x*6)+'deg)';
    });
    c.addEventListener('mouseleave',()=>{c.style.transform=''});
  });
}
// Lenis
addEventListener('load',()=>{
  if(redMot||typeof Lenis==='undefined')return;
  const lenis=new Lenis({lerp:.09,smoothWheel:true});
  function raf(x){lenis.raf(x);requestAnimationFrame(raf)}requestAnimationFrame(raf);
  document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener('click',e=>{const d=document.querySelector(a.getAttribute('href'));if(d){e.preventDefault();lenis.scrollTo(d,{offset:-70})}}));
});
</script>
</body>
