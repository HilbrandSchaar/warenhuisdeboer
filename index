/* ── 7. DE UITGANG ── */
.uitgang{background:var(--papier)}
.uit-grid{display:grid;grid-template-columns:.95fr 1.05fr;gap:52px;align-items:stretch;margin-top:48px}
.uit-info{background:var(--groen);color:var(--wit);padding:42px 40px;border-radius:6px;box-shadow:inset 0 0 0 2px var(--groen), inset 0 0 0 4px rgba(252,248,238,.7), var(--schaduw);position:relative;overflow:hidden}
.uit-info::after{content:"1888";position:absolute;right:-24px;bottom:-46px;font-family:var(--disp);font-size:10rem;color:rgba(217,166,46,.12);line-height:1;pointer-events:none}
.uit-info h3{font-size:1.6rem;margin-bottom:24px}
.uit-rij{display:flex;gap:16px;margin-bottom:20px}
.uit-rij .ic{flex:none;width:38px;height:38px;border-radius:50%;background:rgba(217,166,46,.18);display:flex;align-items:center;justify-content:center}
.uit-rij b{display:block;font-family:var(--caps);font-weight:500;letter-spacing:1.5px;text-transform:uppercase;font-size:.78rem;color:var(--oker)}
.uit-rij span,.uit-rij a{font-size:.95rem;color:rgba(252,248,238,.9);text-decoration:none}
.uit-rij a:hover{color:var(--oker)}
