.gnaam small{font-size:.7rem;color:#8A8070;font-family:var(--caps);letter-spacing:1px;text-transform:uppercase}
.gpag p{font-family:var(--hand);font-weight:500;font-size:1.5rem;line-height:38px;color:#33291B}
