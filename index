.f-col p{font-size:.93rem;line-height:2}
.f-col b{color:var(--wit);font-family:var(--caps);font-weight:500;letter-spacing:2px;text-transform:uppercase;font-size:.8rem}
.f-col a{text-decoration:none}
.f-col a:hover{color:var(--oker)}
.f-bottom{border-top:1px solid rgba(252,248,238,.12);padding-top:22px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;font-size:.82rem;color:rgba(252,248,238,.45)}
.f-bottom a{color:inherit;text-decoration:none}
.f-bottom a:hover{color:var(--oker)}

/* ── pokéballs (max 3, vaag, half buiten beeld) ── */
.pball{position:absolute;border-radius:50%;background:linear-gradient(180deg,#E3350D 0 45%,#22201C 45% 55%,#F6F4EE 55% 100%);box-shadow:inset -6px -8px 14px rgba(0,0,0,.22);pointer-events:none;z-index:1;opacity:.3;filter:blur(1.5px);animation:pfloat 8s ease-in-out infinite}
.pball::after{content:"";position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:26%;height:26%;border-radius:50%;background:#F6F4EE;box-shadow:0 0 0 3px #22201C}
@keyframes pfloat{0%,100%{transform:translateY(0) rotate(-8deg)}50%{transform:translateY(-16px) rotate(8deg)}}

/* ── sterrenstof ── */
.vonk{position:fixed;pointer-events:none;z-index:120;color:var(--oker);text-shadow:0 0 8px rgba(217,166,46,.9);animation:vonkweg .75s cubic-bezier(.2,.7,.4,1) forwards;will-change:transform,opacity}
@keyframes vonkweg{0%{transform:translate(0,0) scale(1) rotate(0)}100%{transform:translate(var(--dx),var(--dy)) scale(0) rotate(var(--dr));opacity:0}}

/* ── reveal ── */
.rv{opacity:0;transform:translateY(34px);transition:opacity 1s cubic-bezier(.16,.8,.26,1), transform 1s cubic-bezier(.16,.8,.26,1);will-change:opacity,transform}
.rv.zien{opacity:1;transform:none}
.v1{transition-delay:.08s}.v2{transition-delay:.16s}.v3{transition-delay:.24s}.v4{transition-delay:.32s}.v5{transition-delay:.4s}

/* ── responsive ── */
@media(max-width:980px){
  .acards{grid-template-columns:repeat(2,1fr)}
