.uit-foto img{width:100%;height:100%;object-fit:cover}
.uit-foto::after{content:"Schrans 94-96 ★";position:absolute;bottom:14px;left:50%;transform:translateX(-50%) rotate(-2deg);background:var(--oker);color:var(--inkt);font-family:var(--hand);font-weight:600;font-size:1.3rem;padding:6px 18px;border-radius:3px;box-shadow:0 8px 20px rgba(36,29,20,.3);white-space:nowrap}
.afscheid{text-align:center;font-family:var(--hand);font-weight:700;font-size:clamp(2rem,4.5vw,3rem);color:var(--groen);margin-top:80px;transform:rotate(-1.5deg)}

/* ── footer ── */
footer{background:var(--groen-d);color:rgba(252,248,238,.75);padding:56px 0 30px;position:relative;z-index:2;border-top:4px solid var(--goud)}
.f-grid{display:flex;justify-content:space-between;gap:34px;flex-wrap:wrap;margin-bottom:40px}
